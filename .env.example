# Taxi Sphere Driver App — переменные окружения
# Скопируйте в .env и заполните значениями

# URL API сервера (без /api/v1/)
EXPO_PUBLIC_API_URL=https://taxitest1.appvault.pro

# URL Socket.IO сервера (обычно совпадает с API)
EXPO_PUBLIC_SOCKET_URL=https://taxitest1.appvault.pro

# ─────────────────────────────────────────────────────────────────────────────
# Секреты — кладутся в .env.local, НЕ в .env
#
# .env лежит в репозитории, .env.local — в .gitignore. Репозиторий публичный,
# поэтому ключ Google в .env заблокирует push (GitHub secret-scanning ловит
# строки вида AIzaSy…) и будет снят ботами в первые минуты.
# ─────────────────────────────────────────────────────────────────────────────

# Ключ Google Maps для Android. Читается в app.config.js → попадает в
# expo.android.config.googleMaps.apiKey → prebuild пишет его в AndroidManifest
# как com.google.android.geo.API_KEY.
#
# Без ключа приложение полностью работоспособно: встроенная карта не
# монтируется (см. src/lib/map-availability.ts), маршрут строится во внешнем
# навигаторе.
#
# Где взять: console.cloud.google.com → Google Maps Platform →
#   1. APIs and services → включить «Maps SDK for Android»
#   2. Keys and credentials → Create credentials → API key
#   3. Ограничить: Application restrictions = Android apps
#      (package pro.appvault.taxisphere.driver + SHA-1 релизного keystore),
#      API restrictions = только Maps SDK for Android
#
# SHA-1 релизного keystore:
#   keytool -list -v -keystore keystore/taxi-sphere-driver.keystore \
#           -alias taxi-sphere-driver
#
# В CI передаётся как GitHub secret с тем же именем (см.
# .github/workflows/build-driver-apk.yml, env на уровне job).
GOOGLE_MAPS_ANDROID_API_KEY=
